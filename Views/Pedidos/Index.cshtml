@model List<SaoJudasLanches.Web.Models.Pedido>
@{
    ViewData["Title"] = "Pedidos";
    var perfil = Context.Session.GetString("PerfilUsuario");
    var ehStaff = perfil == "Admin" || perfil == "Funcionario";
}

<div class="container py-4">
    <div class="page-header">
        <h2>📋 @(ehStaff ? "Pedidos dos Clientes" : "Meus Pedidos")</h2>
        <span class="badge bg-secondary">@Model.Count pedido(s)</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <p>Nenhum pedido encontrado.</p>
            @if (!ehStaff)
            {
                <a asp-action="Registrar" class="btn btn-primary rounded-pill">Fazer meu primeiro pedido</a>
            }
        </div>
    }
    else
    {
        <div class="mt-3">
            @foreach (var pedido in Model)
            {
                <div class="pedido-card">
                    <div class="pedido-header">
                        <span><strong>Pedido #@pedido.Id</strong> — @pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")</span>
                        <span class="badge status-badge-@pedido.Status.Replace(" ", "")">@pedido.Status</span>
                    </div>
                    <div class="pedido-body">
                        @if (ehStaff && pedido.Usuario != null)
                        {
                            <div class="mb-1">
                                <strong>Cliente:</strong> @pedido.Usuario.Nome
                                @if (!string.IsNullOrEmpty(pedido.Usuario.Email))
                                {
                                    <span class="text-muted ms-1">(@pedido.Usuario.Email)</span>
                                }
                            </div>
                        }

                        <div class="mb-1">
                            <strong>Itens:</strong>
                            @string.Join(", ", pedido.Itens.Select(i => $"{i.Quantidade}× {i.ItemCardapio?.Nome}"))
                        </div>

                        @if (ehStaff)
                        {
                            <div class="mb-1">
                                <strong>Pagamento:</strong>
                                @if (!string.IsNullOrEmpty(pedido.MetodoPagamento))
                                {
                                    @pedido.MetodoPagamento
                                    <span class="badge @(pedido.StatusPagamento == "Aprovado" ? "bg-success" : "bg-warning text-dark") ms-1">@pedido.StatusPagamento</span>
                                }
                                else
                                {
                                    <span class="text-muted">Não informado</span>
                                }
                            </div>

                            <div class="mb-1">
                                <strong>Endereço:</strong>
                                @if (pedido.Endereco != null)
                                {
                                    @($"{pedido.Endereco.Rua}, {pedido.Endereco.Numero}")
                                    @if (!string.IsNullOrEmpty(pedido.Endereco.Complemento))
                                    {
                                        @($" — {pedido.Endereco.Complemento}")
                                    }
                                    @($", {pedido.Endereco.Bairro}, {pedido.Endereco.Cidade} - {pedido.Endereco.Estado}, CEP {pedido.Endereco.Cep}")
                                }
                                else
                                {
                                    <span class="text-muted">Retirada no local</span>
                                }
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <strong style="color:var(--primary)">R$ @pedido.Total.ToString("F2")</strong>
                            <div class="d-flex gap-2">
                                <a asp-action="Acompanhar" asp-route-id="@pedido.Id" class="btn btn-outline-secondary btn-sm rounded-pill">Ver</a>
                                @if (perfil == "Admin" || perfil == "Funcionario")
                                {
                                    var pedidoFinalizado = pedido.Status == "Cancelado" || pedido.Status == "Entregue";
                                    @if (perfil == "Funcionario" && pedidoFinalizado)
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-2" style="font-size:0.78rem">Finalizado</span>
                                    }
                                    else
                                    {
                                        <form asp-action="AtualizarStatus" method="post" class="d-flex gap-1">
                                            <input type="hidden" name="id" value="@pedido.Id" />
                                            <select name="status" class="form-select form-select-sm" style="width:auto">
                                                <option>Aguardando</option>
                                                <option>Preparando</option>
                                                <option>Saiu para entrega</option>
                                                <option>Entregue</option>
                                                @if (perfil == "Admin")
                                                {
                                                    <option>Cancelado</option>
                                                }
                                            </select>
                                            <button class="btn btn-primary btn-sm rounded-pill">Atualizar</button>
                                        </form>
                                    }
                                }
                                @if (perfil == "Cliente" && pedido.Status == "Aguardando")
                                {
                                    <form asp-action="CancelarPedido" method="post"
                                          onsubmit="return confirm('Tem certeza que deseja cancelar o pedido #@pedido.Id?')">
                                        <input type="hidden" name="id" value="@pedido.Id" />
                                        <button class="btn btn-outline-danger btn-sm rounded-pill">Cancelar</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
