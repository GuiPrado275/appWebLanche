@model SaoJudasLanches.Web.Models.ItemCardapio
@{ ViewData["Title"] = "Novo Item - Cardápio"; }

<div class="container py-4" style="max-width:520px">
    <div class="page-header"><h2>Novo Item no Cardápio</h2></div>
    <div class="form-card mt-4">
        <form method="post" asp-action="Criar">
            <div class="mb-3">
                <label class="form-label fw-semibold">Nome</label>
                <input asp-for="Nome" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Descrição <small class="text-muted fw-normal">(opcional)</small></label>
                <textarea asp-for="Descricao" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Categoria</label>
                <select asp-for="Categoria" class="form-select" required>
                    <option value="">Selecione...</option>
                    <option>Lanches Tradicionais</option>
                    <option>Hot Dog / Sanduíches</option>
                    <option>Lanches de Frango</option>
                    <option>Filé Mignon</option>
                    <option>Calabresa</option>
                    <option>Pastéis</option>
                    <option>Porções</option>
                    <option>Pizzas</option>
                    <option>Espetos</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Preço (R$)</label>
                <input asp-for="Preco" type="number" step="0.01" min="0" class="form-control" required />
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Estoque Inicial</label>
                <input asp-for="EstoqueAtual" type="number" min="0" class="form-control" required />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill flex-grow-1">Salvar</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill flex-grow-1">Cancelar</a>
            </div>
        </form>
    </div>
</div>
