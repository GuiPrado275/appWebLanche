@model Usuario
@{
    ViewData["Title"] = "Editar Usuário - São Judas Lanches";
    var idLogado = Context.Session.GetString("UsuarioId");
    var ehElePropio = Model.Id == idLogado;
}

<div class="container py-4" style="max-width: 500px;">
    <div class="page-header">
        <h2>Editar Usuário</h2>
    </div>

    <div class="form-card mt-4">
        <form method="post" asp-controller="Usuarios" asp-action="Editar">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Senha" />

            <div class="mb-3">
                <label class="form-label">Nome Completo</label>
                <input asp-for="Nome" class="form-control" placeholder="Nome completo" required />
            </div>

            <div class="mb-3">
                <label class="form-label">E-mail</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="email@exemplo.com" required />
            </div>

            <div class="mb-4">
                <label class="form-label">Perfil</label>
                @if (ehElePropio)
                {
                    // Admin não pode alterar o próprio perfil
                    <input type="hidden" asp-for="Perfil" />
                    <input class="form-control" value="Admin" disabled />
                    <small class="text-muted">Você não pode alterar o seu próprio perfil.</small>
                }
                else
                {
                    <select asp-for="Perfil" class="form-select" required>
                        <option value="Cliente">Cliente</option>
                        <option value="Funcionario">Funcionário</option>
                    </select>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill flex-grow-1">Salvar</button>
                <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary rounded-pill flex-grow-1">Cancelar</a>
            </div>
        </form>
    </div>
</div>
